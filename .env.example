# Unset = local SQLite (jobs.db). Do NOT leave this as an empty value — an empty
# DATABASE_URL overrides the default and breaks the engine. Either omit it or set a
# real URL, e.g. DATABASE_URL=postgresql+asyncpg://user:pass@host/db
# How often to run scraper (hours)
SCRAPE_INTERVAL_HOURS=6
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

